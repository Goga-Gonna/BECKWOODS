# PostgreSQL
DATABASE_URL="postgresql://beckwoods:beckwoods@localhost:5432/beckwoods?schema=public"

# Секрет для подписи сессии администратора (минимум 32 символа).
# Сгенерировать: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Первый администратор (создаётся командой npm run db:seed)
ADMIN_EMAIL="admin@beckwoods.store"
ADMIN_PASSWORD="change-this-password-now"

# Публичный адрес сайта (для SEO и ссылок)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Оплата ОТКЛЮЧЕНА до юридической проверки. Не менять на true без согласования.
PAYMENT_ENABLED="false"
